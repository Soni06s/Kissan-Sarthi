NODE_ENV=development
PORT=5000
MONGODB_URI=YOUR_MONGODB_ATLAS_URI_HERE
# Example: mongodb+srv://<username>:<password>@cluster0.9upjnwt.mongodb.net/kissansarthi?retryWrites=true&w=majority

JWT_ACCESS_SECRET=change_this_access_secret_min_32_characters_long
JWT_REFRESH_SECRET=change_this_refresh_secret_min_32_characters_long
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
JWT_SECRET=JWT_SECRET
CLIENT_URL=http://localhost:5173

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

OPENWEATHER_API_KEY=
MANDI_API_KEY=/resource/9ef84268-d588-465a-a308-a864a43d0070
GEMINI_API_KEY=your_gemini_api_key_here
# SMTP settings for nodemailer
# Example for Gmail: set EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=465, EMAIL=you@gmail.com, EMAIL_PASSWORD="your app password with spaces"
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL=you@gmail.com
EMAIL_PASSWORD="your_app_password_or_app_password_with_spaces"
EMAIL_FROM=

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay Test Mode Configuration
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
